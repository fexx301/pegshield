{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PegShield discovery lock",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "observedAt",
    "gitCommit",
    "networks",
    "attestcoin",
    "fixture",
    "toolchain",
    "evidence"
  ],
  "properties": {
    "$schema": { "const": "./schemas/discovery-lock.schema.json" },
    "observedAt": { "type": "string", "format": "date-time" },
    "gitCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "networks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cc3", "ethereum"],
      "properties": {
        "cc3": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "chainId",
            "rpcUrl",
            "latestBlock",
            "blockProver",
            "chainInfo",
            "decoder"
          ],
          "properties": {
            "chainId": { "const": 102031 },
            "rpcUrl": { "type": "string", "format": "uri" },
            "latestBlock": { "type": "integer", "minimum": 0 },
            "blockProver": { "$ref": "#/$defs/precompile" },
            "chainInfo": { "$ref": "#/$defs/precompile" },
            "decoder": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "required",
                "address",
                "codeHash",
                "fixtureTransactionType"
              ],
              "properties": {
                "required": { "const": true },
                "address": { "$ref": "#/$defs/address" },
                "codeHash": { "$ref": "#/$defs/bytes32" },
                "fixtureTransactionType": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 4
                }
              }
            }
          }
        },
        "ethereum": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "chainId",
            "attestcoinChainKey",
            "usdcUsdProxy",
            "underlyingAggregator",
            "aggregatorCodeHash",
            "feedDecimals",
            "description",
            "answerUpdatedTopic0",
            "answerUpdatedAbi"
          ],
          "properties": {
            "chainId": { "const": 1 },
            "attestcoinChainKey": { "const": 3 },
            "usdcUsdProxy": { "$ref": "#/$defs/address" },
            "underlyingAggregator": { "$ref": "#/$defs/address" },
            "aggregatorCodeHash": { "$ref": "#/$defs/bytes32" },
            "feedDecimals": { "const": 8 },
            "description": { "const": "USDC / USD" },
            "answerUpdatedTopic0": { "$ref": "#/$defs/bytes32" },
            "answerUpdatedAbi": {
              "type": "object",
              "additionalProperties": false,
              "required": ["signature", "topics", "data"],
              "properties": {
                "signature": {
                  "const": "AnswerUpdated(int256,uint256,uint256)"
                },
                "topics": {
                  "type": "array",
                  "prefixItems": [
                    { "const": "topic0" },
                    { "const": "indexed int256 current" },
                    { "const": "indexed uint256 roundId" }
                  ],
                  "items": false,
                  "minItems": 3,
                  "maxItems": 3
                },
                "data": { "const": "uint256 updatedAt" }
              }
            }
          }
        }
      }
    },
    "attestcoin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sdkPackage",
        "sdkVersion",
        "proofServiceUrl",
        "proofServiceHealth",
        "sdkEntrypoint",
        "sdkProofMethod",
        "proofTypeDeclaration",
        "solidityVerifierInterface",
        "receiptStatusRule",
        "verificationReturnShape"
      ],
      "properties": {
        "sdkPackage": { "const": "@gluwa/usc-sdk" },
        "sdkVersion": { "const": "0.18.0" },
        "proofServiceUrl": { "type": "string", "format": "uri" },
        "proofServiceHealth": {
          "type": "object",
          "additionalProperties": false,
          "required": ["endpoint", "attestedHeight"],
          "properties": {
            "endpoint": { "type": "string", "format": "uri" },
            "attestedHeight": { "type": "integer", "minimum": 0 }
          }
        },
        "sdkEntrypoint": { "type": "string", "minLength": 1 },
        "sdkProofMethod": { "type": "string", "minLength": 1 },
        "proofTypeDeclaration": { "type": "string", "minLength": 1 },
        "solidityVerifierInterface": { "type": "string", "minLength": 1 },
        "receiptStatusRule": { "type": "string", "minLength": 1 },
        "verificationReturnShape": { "type": "string", "minLength": 1 }
      }
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transactionHash",
        "blockNumber",
        "rpcBlockLogIndex",
        "receiptLogPosition",
        "roundId",
        "answer",
        "updatedAt",
        "proofSha256",
        "proofBytes",
        "txBytesLength",
        "generationMs",
        "verificationGasEstimate",
        "cc3VerificationTransaction"
      ],
      "properties": {
        "transactionHash": { "$ref": "#/$defs/hash" },
        "blockNumber": { "type": "integer", "minimum": 0 },
        "rpcBlockLogIndex": { "type": "integer", "minimum": 0 },
        "receiptLogPosition": { "type": "integer", "minimum": 0 },
        "roundId": { "type": "string", "pattern": "^[0-9]+$" },
        "answer": { "type": "string", "pattern": "^-?[0-9]+$" },
        "updatedAt": { "type": "integer", "minimum": 0 },
        "proofSha256": { "$ref": "#/$defs/sha256" },
        "proofBytes": { "type": "integer", "minimum": 1 },
        "txBytesLength": { "type": "integer", "minimum": 1 },
        "generationMs": { "type": "integer", "minimum": 0 },
        "verificationGasEstimate": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "cc3VerificationTransaction": { "type": "string", "minLength": 1 }
      }
    },
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node", "pnpm", "forge", "solc", "frontendLockfileSha256"],
      "properties": {
        "node": { "type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "pnpm": { "const": "11.22.0" },
        "forge": { "type": "string", "pattern": "^1\\.7\\.1\\+[0-9a-f]{40}$" },
        "solc": { "const": "0.8.28" },
        "frontendLockfileSha256": { "type": ["string", "null"] }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "field",
          "source",
          "reference",
          "command",
          "observed",
          "observedAt"
        ],
        "properties": {
          "field": { "type": "string", "minLength": 1 },
          "source": {
            "enum": [
              "official-doc",
              "rpc",
              "source-code",
              "live-transaction",
              "installed-package"
            ]
          },
          "reference": { "type": "string", "minLength": 1 },
          "command": { "type": "string", "minLength": 1 },
          "observed": { "type": "string", "minLength": 1 },
          "observedAt": { "type": "string", "format": "date-time" }
        }
      }
    }
  },
  "$defs": {
    "address": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
    "bytes32": { "type": "string", "pattern": "^0x[0-9a-fA-F]{64}$" },
    "hash": { "type": "string", "pattern": "^0x[0-9a-fA-F]{64}$" },
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "precompile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["address", "codeHash"],
      "properties": {
        "address": { "$ref": "#/$defs/address" },
        "codeHash": {
          "type": ["string", "null"],
          "pattern": "^0x[0-9a-fA-F]{64}$"
        }
      }
    }
  }
}
