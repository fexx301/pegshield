{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PegShield normalized Attestcoin proof artifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "version",
    "source",
    "decodedExpected",
    "proof",
    "integrity"
  ],
  "properties": {
    "$schema": { "const": "../../docs/schemas/proof-artifact.schema.json" },
    "version": { "const": 1 },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chainId",
        "chainKey",
        "transactionHash",
        "blockNumber",
        "transactionIndex",
        "rpcBlockLogIndex",
        "receiptLogPosition",
        "emitter"
      ],
      "properties": {
        "chainId": { "const": 1 },
        "chainKey": { "const": 3 },
        "transactionHash": { "$ref": "#/$defs/hash" },
        "blockNumber": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "transactionIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "rpcBlockLogIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "receiptLogPosition": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "emitter": { "$ref": "#/$defs/address" }
      }
    },
    "decodedExpected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "topic0",
        "topics",
        "data",
        "roundId",
        "answer",
        "updatedAt",
        "receiptStatus"
      ],
      "properties": {
        "topic0": { "$ref": "#/$defs/hash" },
        "topics": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": { "$ref": "#/$defs/hash" }
        },
        "data": { "type": "string", "pattern": "^0x[0-9a-fA-F]{64}$" },
        "roundId": { "$ref": "#/$defs/decimal" },
        "answer": { "type": "string", "pattern": "^-?[0-9]+$" },
        "updatedAt": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "receiptStatus": { "const": "success" }
      }
    },
    "proof": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sdkVersion",
        "chainKey",
        "headerNumber",
        "txIndex",
        "txHash",
        "txBytes",
        "merkleProof",
        "continuityProof",
        "cached",
        "generatedAt"
      ],
      "properties": {
        "sdkVersion": { "const": "0.18.0" },
        "chainKey": { "const": 3 },
        "headerNumber": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "txIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "txHash": { "$ref": "#/$defs/hash" },
        "txBytes": { "type": "string", "pattern": "^0x[0-9a-fA-F]+$" },
        "merkleProof": {
          "type": "object",
          "additionalProperties": false,
          "required": ["root", "siblings"],
          "properties": {
            "root": { "$ref": "#/$defs/hash" },
            "siblings": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["hash", "isLeft"],
                "properties": {
                  "hash": { "$ref": "#/$defs/hash" },
                  "isLeft": { "type": "boolean" }
                }
              }
            }
          }
        },
        "continuityProof": {
          "type": "object",
          "additionalProperties": false,
          "required": ["lowerEndpointDigest", "roots"],
          "properties": {
            "lowerEndpointDigest": { "$ref": "#/$defs/hash" },
            "roots": { "type": "array", "items": { "$ref": "#/$defs/hash" } }
          }
        },
        "cached": { "type": "boolean" },
        "generatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonicalJsonSha256", "rawSdkJsonSha256"],
      "properties": {
        "canonicalJsonSha256": { "$ref": "#/$defs/sha256" },
        "rawSdkJsonSha256": { "$ref": "#/$defs/sha256" }
      }
    }
  },
  "$defs": {
    "address": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
    "hash": { "type": "string", "pattern": "^0x[0-9a-fA-F]{64}$" },
    "decimal": { "type": "string", "pattern": "^[0-9]+$" },
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
