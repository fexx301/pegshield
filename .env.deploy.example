# The deploy script refuses to run when its output manifest already exists.
# For a superseding rehearsal, set DEPLOYMENT_MANIFEST_PATH to a new path
# (for example ../deployments/cc3-testnet-v4.json) before broadcasting.
# Never commit populated values. Deploy only to CC3 testnet (chain 102031).
# Optional RPC override; keep the default CC3 endpoint if omitted.
CC3_RPC_URL=https://rpc.cc3-testnet.creditcoin.network
DEPLOYER_PRIVATE_KEY=
UNDERWRITER_PRIVATE_KEY=
POLICYHOLDER_PRIVATE_KEY=
DEPLOYER_ADDRESS=
UNDERWRITER_ADDRESS=
POLICYHOLDER_ADDRESS=
TREASURY_ADDRESS=
DEMO_MINTER_ADDRESS=
SOURCE_AGGREGATOR=0xc9e1a09622afdB659913fefE800fEaE5DBbFe9d7
DEMO_LIQUIDITY=1000000000
DEMO_POLICYHOLDER_BALANCE=1000000000
DEMO_COVERAGE=100000000
# Required: set this at deployment from a current Ethereum feed answer plus a
# visible demo margin. Run `pnpm demo:trigger -- --margin-bps 100`; copy its
# envLine. 99,000,000 (0.99) is not guaranteed to trigger.
DEMO_TRIGGER_BELOW=
# PegShieldPool enforces a 5-minute minimum activation delay
# (MIN_ACTIVATION_DELAY); values below 300 revert createProduct.
DEMO_ACTIVATION_DELAY=300
# Use a long demo window so two real source observations can arrive. These
# values are testnet-only and must be reviewed before every deployment.
DEMO_POLICY_DURATION=604800
DEMO_CLAIM_GRACE_PERIOD=21600
DEMO_MIN_BREACH_DURATION=300
DEMO_PREMIUM_BPS=250
DEMO_MAX_COVERAGE=500000000
# Optional after deployment; this key may submit permissionless proofs only.
RELAYER_ADDRESS=
RELAYER_PRIVATE_KEY=
